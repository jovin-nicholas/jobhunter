# Copy to .env and fill in. Nothing here is needed for the default local setup (Laya + Ollama).

# Names removed from resumes before any model sees them (comma-separated). Optional: without it, the name is read
# from the default resume's first line. If you set it, use your own name(s), e.g.:
# CANDIDATE_NAMES=John Doe,Johnny Doe

# Notifications (optional): uncomment and fill in the channels you list under `notify:` in jobhunter.yaml.
# Placeholder values here would make every alert fail.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=your 16-character app password
# NOTIFY_EMAIL=you@example.com

# Optional cloud scorers (free tiers). Several keys, comma-separated, are rotated when one is rate limited.
# GEMINI_API_KEYS=key1,key2
# GROQ_API_KEYS=key1,key2

# Optional ATS discovery through Google Custom Search (100 free queries a day)
# GOOGLE_API_KEY=
# GOOGLE_CX=
